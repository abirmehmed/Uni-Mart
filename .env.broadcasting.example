# Append these to your real .env file.
# Install with: composer require laravel/reverb  →  php artisan reverb:install
# (that command generates the REVERB_APP_* keys below for you)

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=unimart
REVERB_APP_KEY=unimart-key
REVERB_APP_SECRET=unimart-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Run the broadcast server alongside `php artisan serve`:
#   php artisan reverb:start
